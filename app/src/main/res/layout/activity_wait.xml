<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wait_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#000000">

    ```
    <!-- Logo -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/spacepong_logo"
        android:scaleType="fitCenter"
        android:contentDescription="Logo"
        android:layout_marginBottom="20dp"/>

    <!-- Estado -->
    <TextView
        android:id="@+id/statusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ESPERANDO JUGADORES"
        android:textColor="#00ff9c"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- ProgressBar centrado -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:layout_marginBottom="20dp"/>

    <!-- Contador -->
    <TextView
        android:id="@+id/countdownLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="..."
        android:textColor="#00ff9c"
        android:textSize="36sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- Información adicional -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cuando ambos jugadores se conecten"
        android:textColor="#61c89c"
        android:textSize="14sp"
        android:gravity="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="el juego comenzará automáticamente"
        android:textColor="#61c89c"
        android:textSize="14sp"
        android:gravity="center"/>
    ```

</LinearLayout>